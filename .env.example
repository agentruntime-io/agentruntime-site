# Copy to .env.local and fill in. All VITE_* values are bundled into the public site.

# Contact form endpoint (src/config/api.ts)
VITE_CONTACT_FORM_ENDPOINT=

# Backend for the public connector catalog (src/config/api.ts)
VITE_BFF_URL=

# PostHog product analytics (src/lib/analytics.ts). Leave the key empty to disable
# PostHog and the cookie banner. Use the console's EU project so site visits can be
# linked to console signups, and enable cookieless mode in the project settings.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com
